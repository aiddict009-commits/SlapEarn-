# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ---------------------------------------------------------------------------
# TELEGRAM MINI APP (formless login — no sign-up prompts)
# ---------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN: BotFather token of the bot that hosts this Mini App.
# Used to verify the HMAC signature of `initData` before a Firebase session is
# created for the Telegram user. Without it the API falls back to an UNSIGNED
# development mode (fine for testing, never for production).
TELEGRAM_BOT_TOKEN="123456789:AAExampleTokenFromBotFather"

# TELEGRAM_ALLOW_UNVERIFIED: force-accept unsigned Telegram payloads (dev only).
# Leave unset in production. "false" always enforces signature verification.
# TELEGRAM_ALLOW_UNVERIFIED="false"

# TELEGRAM_AUTH_MAX_AGE_SECONDS: how old a Telegram payload may be (default 86400).
# TELEGRAM_AUTH_MAX_AGE_SECONDS="86400"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MYLEAD_SECRET_TOKEN: Optional secret token to verify MyLead postback requests.
MYLEAD_SECRET_TOKEN="your_mylead_secret_token_here"

# CPX_RESEARCH_SECRET: App secret key to verify CPX Research postback secure_hash signatures.
CPX_RESEARCH_SECRET="your_cpx_research_secret_key_here"
