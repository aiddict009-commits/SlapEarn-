rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read/write for user documents and subcollections
    match /{path=**}/transactions/{transactionId} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read, write: if true;

      match /transactions/{transactionId} {
        allow read, write: if true;
      }

      match /notifications/{notificationId} {
        allow read, write: if true;
      }
    }

    // Global announcements collection published by admin
    match /announcements/{announcementId} {
      allow read, write: if true;
    }

    match /withdrawals/{withdrawalId} {
      allow read, write: if true;
    }

    match /security_logs/{logId} {
      allow read, write: if true;
    }

    match /security_config/{docId} {
      allow read, write: if true;
    }

    match /economy_config/{docId} {
      allow read, write: if true;
    }

    match /system/{docId} {
      allow read, write: if true;
    }

    match /weekly_leaderboard_payouts/{docId} {
      allow read, write: if true;
    }

    match /monthly_referral_payouts/{docId} {
      allow read, write: if true;
    }

    match /leaderboard_prize_dedup/{docId} {
      allow read, write: if true;
    }

    match /monthly_referral_prize_dedup/{docId} {
      allow read, write: if true;
    }

    match /external_postbacks/{docId} {
      allow read, write: if true;
    }
  }
}
